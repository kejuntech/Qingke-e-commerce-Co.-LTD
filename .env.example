# Qingke 新站环境变量模板
# 复制为 .env 后再填入自己的值；真实 .env 不得提交到 Git。
# Render 生产环境请在新站服务的 Dashboard > Environment 中配置，不要上传此文件。

# Server
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=https://example.com

# One-time remote admin bootstrap. Required when NODE_ENV=production and auth.json does not exist.
# Use a random 24+ character value. Remove or rotate it after initializing the admin.
# Keep auth.json on persistent storage or administrator setup could be required again after a redeploy.
ADMIN_SETUP_TOKEN=

# Persistent data directory. In Render, attach a persistent disk at this exact mount path.
# Ensure DATA_DIR and the disk mount path match; do not assume the app filesystem persists.
DATA_DIR=./data

# PostgreSQL (leave blank for isolated local JSON-mode testing only)
DATABASE_URL=
# Enable only after data migration and verification. Comma-separated collection filenames.
POSTGRES_RUNTIME_COLLECTIONS=
# Keep default TLS verification behavior; set disable only for a specifically approved local/test database.
PGSSLMODE=
PGPOOL_MAX=10

# Reverse proxy trust. Keep false unless the proxy chain is understood and validated.
TRUST_PROXY=false

# SMTP email delivery (configure with provider credentials in your local secret manager / Render dashboard)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_ADMIN_EMAIL=

# PayPal: use sandbox for staging; do not use live mode until the full sandbox flow passes.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Translation provider: HTTPS endpoint compatible with the application's expected API format.
TRANSLATION_API_URL=
TRANSLATION_API_KEY=
TRANSLATION_MODEL=

# Encrypted backups: use a strong, unique passphrase of at least 16 characters.
# Never store the real passphrase in source control or send it in chat.
KEJUN_BACKUP_PASSPHRASE=
BACKUP_DIR=./backups
BACKUP_KEEP_COUNT=10
BACKUP_MAX_AGE_DAYS=90
SECURE_BACKUP_DIR=./backups/encrypted

# Optional remote smoke test controls
SMOKE_BASE_URL=
SMOKE_REQUEST_TIMEOUT_MS=10000
